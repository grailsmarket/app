NODE_ENV=development
NODE_OPTIONS=--no-warnings

# Optional server override; when empty, server routes use NEXT_PUBLIC_GRAILS_API_URL.
GRAILS_API_URL=
NEXT_PUBLIC_GRAILS_API_URL=https://api.grails.app/api/v1

# ENSv2 worker base URL (this instance is Sepolia; use a matching worker when changing chains)
NEXT_PUBLIC_ENS_V2_API_URL=https://sepolia-ensv2.on.hotbox.wtf

# Optional server override; when empty, server routes use NEXT_PUBLIC_ENS_METADATA_URL.
ENS_METADATA_URL=
NEXT_PUBLIC_ENS_METADATA_URL=https://metadata.ethid.org

# Server-only token used by /api/name/metadata/refresh.
ENS_METADATA_CACHE_INVALIDATION_TOKEN=
# Legacy fallback for ENS_METADATA_CACHE_INVALIDATION_TOKEN.
CACHE_INVALIDATION_TOKEN=

NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

NEXT_PUBLIC_QUICKNODE_ID=

NEXT_PUBLIC_MAINNET_ALCHEMY_ID=
NEXT_PUBLIC_SEPOLIA_ALCHEMY_ID=
NEXT_PUBLIC_BASE_ALCHEMY_ID=
NEXT_PUBLIC_BASE_SEPOLIA_ALCHEMY_ID=
NEXT_PUBLIC_OPTIMISM_ALCHEMY_ID=
NEXT_PUBLIC_OP_SEPOLIA_ALCHEMY_ID=

# Server-only key takes precedence; existing NEXT_PUBLIC_OPENSEA_API_KEY is a fallback.
OPENSEA_API_KEY=
NEXT_PUBLIC_OPENSEA_API_KEY=
# Optional server override; set the OpenSea API host appropriate for the configured chain.
OPENSEA_API_URL=
NEXT_PUBLIC_OPENSEA_API_URL=https://api.opensea.io

NEXT_PUBLIC_USE_CONDUIT=true
NEXT_PUBLIC_CAN_CLAIM_POAP=true

X_BEARER_TOKEN=

# Optional analytics (browser and server events).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional build-time source map upload credentials.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Chain for ENS + the marketplace: 1 (mainnet) or 11155111 (Sepolia)
NEXT_PUBLIC_CHAIN_ID=1

NEXT_PUBLIC_OPENSEA_FEE_BASIS_POINTS=100

NEXT_PUBLIC_USE_CONDUIT=true
NEXT_PUBLIC_CAN_CLAIM_POAP=false

NEXT_PUBLIC_WETH_ADDRESS=0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2
NEXT_PUBLIC_USDC_ADDRESS=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
NEXT_PUBLIC_DAI_ADDRESS=0x6b175474e89094c44da98b954eedeac495271d0f
NEXT_PUBLIC_ENS_ADDRESS=0xc18360217d8f7ab5e7c516566761ea12ce7f9d72

# ------------ # ENS V2 Addresses - Mainnet -------------
